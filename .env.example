# Public URL (used for canonical links, sitemap, emails). Baked in at build time.
NEXT_PUBLIC_SITE_URL=https://nancylemflorist.com

# Admin dashboard at /admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string, at least 32 characters (signs the admin session cookie)
AUTH_SECRET=replace-with-64-random-characters

# Where orders/inquiries are stored (JSON). Use a folder OUTSIDE the app dir on Hostinger
# so redeploys don't wipe it, e.g. /home/u123456789/nancylemflorist-data
DATA_DIR=./data

# Hostinger email (hPanel -> Emails). Leave blank to skip sending email.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@nancylemflorist.com
SMTP_PASS=
# Inbox that receives new order/inquiry notifications
SHOP_EMAIL=contact@nancylemflorist.com
